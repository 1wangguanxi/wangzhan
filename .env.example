# Go only connects to this project's local database.
DATABASE_URL=postgres://zhiyu:zhiyu_local@127.0.0.1:55432/zhiyu?sslmode=disable
API_ADDR=127.0.0.1:8080
# Next server -> Go server; never exposed to browser bundles.
CONTENT_API_URL=http://127.0.0.1:8080
# Website URL used by structured data (set for build and runtime)
SITE_URL=http://127.0.0.1:3000
# Admin -> website public URL (build-time browser setting)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Enable for an HTTPS production deployment; false is for local HTTP only.
COOKIE_SECURE=false
# Paths are relative to the Go server working directory (repository root).
PUBLIC_DIR=apps/web/public
UPLOAD_DIR=.runtime/uploads
