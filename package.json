{
  "name": "zhiyu-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/content",
    "packages/admin-contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@zhiyu/web",
    "build": "npm run build --workspace=@zhiyu/web && npm run build --workspace=@zhiyu/admin",
    "start": "npm run start --workspace=@zhiyu/web",
    "typecheck": "npm run typecheck --workspace=@zhiyu/web && npm run typecheck --workspace=@zhiyu/admin",
    "test:api": "cd apps/api && go test ./...",
    "format": "prettier --write apps/web/src packages/content scripts docs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "dev:admin": "npm run dev --workspace=@zhiyu/admin",
    "start:admin": "npm run start --workspace=@zhiyu/admin"
  },
  "devDependencies": {
    "parse5": "8.0.1",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
