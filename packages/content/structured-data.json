          "@type": "HowTo",
          "@id": "{{SITE_URL}}/process.html#howto",
          "name": "毕业论文辅导服务流程",
          "description": "从咨询沟通到答辩辅导的六步服务流程，大部分事情由公司推进，学生只在关键节点配合。",
          "step": [
            {
              "@type": "HowToStep",
              "position": 1,
              "name": "咨询沟通",
              "text": "扫码说明专业、题目、截止时间，当天评估难度并出方案和报价。"
            },
            {
              "@type": "HowToStep",
              "position": 2,
              "name": "下单建档",
              "text": "填下单表、付定金50%、发学校模板等资料，建专属服务群并分配辅导老师。"
            },
            {
              "@type": "HowToStep",
              "position": 3,
              "name": "开题大纲",
              "text": "按学校模板做开题报告和任务书（2-3天），搭三级大纲（1-2天），确认后写正文。"
            },
            {
              "@type": "HowToStep",
              "position": 4,
              "name": "初稿交付",
              "text": "按大纲进行全文写作辅导（5-10天），水印版核对，确认后付尾款开放无水印完整文件。"
            },
            {
              "@type": "HowToStep",
              "position": 5,
              "name": "修改定稿",
              "text": "按修改意见每轮2天修改，查重降重、格式排版，交付定稿和查重报告。"
            },
            {
              "@type": "HowToStep",
              "position": 6,
              "name": "答辩辅导",
              "text": "PPT框架建议、预判10-15个问题、话术指导、免费模拟答辩1次。"
            }
          ]
        }
      ]
    }
